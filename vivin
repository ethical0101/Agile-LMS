from collections import deque
cap1, cap2, target = map(int, input("Enter jug1 jug2 target: ").split())
queue = deque([(0, 0)])
visited = set()
print("Steps:")
while queue:
    x, y = queue.popleft()
    if (x, y) in visited:
        continue
    visited.add((x, y))
    print(x, y)
    if x == target or y == target:
        print("Target reached")
        break
    queue.append((cap1, y))
    queue.append((x, cap2))
    queue.append((0, y))
    queue.append((x, 0))
    queue.append((max(0, x - (cap2 - y)), min(cap2, x + y)))
    queue.append((min(cap1, x + y), max(0, y - (cap1 - x))))


