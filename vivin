N = 8
# Function to print solution
def print_board(board):
    for row in board:
        print(" ".join("Q" if col else "." for col in row))
    print("\n")
# Check if it's safe to place queen
def is_safe(board, row, col):
    # Check column
    for i in range(row):
        if board[i][col]:
            return False
    # Check left diagonal
    i, j = row - 1, col - 1
    while i >= 0 and j >= 0:
        if board[i][j]:
            return False
        i -= 1
        j -= 1
    # Check right diagonal
    i, j = row - 1, col + 1
    while i >= 0 and j < N:
        if board[i][j]:
            return False
        i -= 1
        j += 1
    return True
# Backtracking function
def solve(board, row):
    if row == N:
        print_board(board)
        return True   # change to False if you want ALL solutions
    for col in range(N):
        if is_safe(board, row, col):
            board[row][col] = 1
            if solve(board, row + 1):
                return True
            board[row][col] = 0  # backtrack
    return False
# Driver code
board = [[0 for _ in range(N)] for _ in range(N)]
if not solve(board, 0):
    print("No solution exists")

Travelling Salesman Problem
import random
# Calculate total distance of a tour
def calculate_distance(tour, dist_matrix):
    total = 0
    for i in range(len(tour)):
        total += dist_matrix[tour[i]][tour[(i + 1) % len(tour)]]
    return total
# Generate neighbor by swapping two cities
def get_neighbor(tour):
    new_tour = tour[:]
    i, j = random.sample(range(len(tour)), 2)
    new_tour[i], new_tour[j] = new_tour[j], new_tour[i]
    return new_tour
# Hill Climbing Algorithm
def hill_climbing(dist_matrix):
    n = len(dist_matrix)
    # Initial random tour
    current_tour = list(range(n))
    random.shuffle(current_tour)
    current_distance = calculate_distance(current_tour, dist_matrix)
    while True:
        neighbor = get_neighbor(current_tour)
        neighbor_distance = calculate_distance(neighbor, dist_matrix)
        # Move to better neighbor
        if neighbor_distance < current_distance:
            current_tour = neighbor
            current_distance = neighbor_distance
        else:
            break   # stop when no better neighbor

    return current_tour, current_distance
#  User Input
n = int(input("Enter number of cities: "))
print("Enter distance matrix:")
dist_matrix = []
for i in range(n):
    row = list(map(int, input().split()))
    dist_matrix.append(row)
# Run algorithm
tour, distance = hill_climbing(dist_matrix)
# Output
print("\nBest Tour Found:", tour)
print("Minimum Distance:", distance)

