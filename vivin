# Monkey Banana Problem using simple planning (State Space Search)
class State:
    def __init__(self, monkey_pos, box_pos, monkey_on_box, has_banana):
        self.monkey_pos = monkey_pos
        self.box_pos = box_pos
        self.monkey_on_box = monkey_on_box
        self.has_banana = has_banana
    def __eq__(self, other):
        return (self.monkey_pos == other.monkey_pos and
                self.box_pos == other.box_pos and
                self.monkey_on_box == other.monkey_on_box and
                self.has_banana == other.has_banana)
    def __hash__(self):
        return hash((self.monkey_pos, self.box_pos,
                     self.monkey_on_box, self.has_banana))
    def __str__(self):
        return f"Monkey:{self.monkey_pos}, Box:{self.box_pos}, OnBox:{self.monkey_on_box}, Banana:{self.has_banana}"
# Possible actions
def get_next_states(state):
    next_states = []
    # Move monkey
    for pos in ['A', 'B', 'C']:
        if pos != state.monkey_pos and not state.monkey_on_box:
            next_states.append(("Move to " + pos,
                                State(pos, state.box_pos,
                                      state.monkey_on_box,
                                      state.has_banana)))
    # Push box
    if state.monkey_pos == state.box_pos and not state.monkey_on_box:
        for pos in ['A', 'B', 'C']:
            if pos != state.box_pos:
                next_states.append(("Push box to " + pos,
                                    State(pos, pos,
                                          False,
                                          state.has_banana)))
    # Climb box
    if state.monkey_pos == state.box_pos and not state.monkey_on_box:
        next_states.append(("Climb box",
                            State(state.monkey_pos, state.box_pos,
                                  True, state.has_banana)))
    # Grab banana
    if state.monkey_on_box and state.monkey_pos == 'B':  # Banana at position B
        next_states.append(("Grab banana",
                            State(state.monkey_pos, state.box_pos,
                                  state.monkey_on_box, True)))
    return next_state
# Goal check
def is_goal(state):
    return state.has_banana
# DFS search
def dfs(state, visited, path):
    if is_goal(state):
        return path
    visited.add(state)
    for action, next_state in get_next_states(state):
        if next_state not in visited:
            result = dfs(next_state, visited, path + [(action, next_state)])
            if result:
                return result
    return None
# Initial state
initial_state = State(monkey_pos='A', box_pos='C',
                      monkey_on_box=False, has_banana=False)
# Run
solution = dfs(initial_state, set(), [])
print("Initial State:")
print(initial_state)
if solution:
    print("\nSolution Steps:\n")
    for step, (action, state) in enumerate(solution, 1):
        print(f"Step {step}: {action}")
        print(state)
else:
    print("No solution found!")

