import heapq
graph = {}
edges = int(input("Enter number of edges: "))
for _ in range(edges):
    u, v, w = input("Enter u v weight: ").split()
    graph.setdefault(u, []).append((v, int(w)))
heuristic = {}
n = int(input("Enter number of heuristic values: "))
for _ in range(n):
    node, h = input("Enter node heuristic: ").split()
    heuristic[node] = int(h)
start, goal = input("Enter start and goal: ").split()
pq = [(heuristic[start], 0, start)]
visited = set()
while pq:
    f, cost, node = heapq.heappop(pq)
    if node == goal:
        print("Cost:", cost)
        break
    if node in visited:
        continue
    visited.add(node)
    for neighbor, weight in graph.get(node, []):
        new_cost = cost + weight
        heapq.heappush(pq, (new_cost + heuristic[neighbor], new_cost, neighbor))




