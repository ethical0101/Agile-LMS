    def __init__(self, initial, goal):
        self.state = initial
        self.goal = goal
        self.plan = []
    def clear(self, block):
        for b in self.state:
            if self.state[b] == block:
                return False
        return True
    def move(self, block, dest):
        source = "Table" if self.state[block] is None else self.state[block]
        destination = "Table" if dest is None else dest
        self.state[block] = dest
        self.plan.append(f"Move {block} from {source} to {destination}")
    def solve(self):
        for block in self.goal:
            goal_pos = self.goal[block]
            if self.state[block] != goal_pos:
                if self.clear(block):
                    self.move(block, goal_pos)
        return self.plan
