3. def dls(tree, node, goal, depth, path):
    if depth < 0:
        return None
    path.append(node)
    if node == goal:
        return path
    if depth == 0:
        path.pop()
        return None
    for child in tree.get(node, []):
        result = dls(tree, child, goal, depth-1, path)
        if result:
            return result
    path.pop()
    return None
def ids(tree, start, goal, max_depth):
    for depth in range(max_depth + 1):
        result = dls(tree, start, goal, depth, [])
        if result:
            return result
    return None
    
