9. def hill_climbing(graph, heights, start):
    current = start
    path = [current]
    while True:
        neighbors = graph.get(current, [])
        # If no neighbors, stop
        if not neighbors:
            break
        # Assume first neighbor is best initially
        best_neighbor = neighbors[0]
        # Find neighbor with maximum height
        for n in neighbors:
            if heights[n] > heights[best_neighbor]:
                best_neighbor = n
        # Move to better neighbor if exists
        if heights[best_neighbor] > heights[current]:
            current = best_neighbor
            path.append(current)
        else:
            # Local maximum reached
            break
    return current, path
