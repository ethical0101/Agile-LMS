    p_origin_no = len(no_rows[no_rows["Origin"] == origin]) / len(no_rows)
    # Posterior probabilities
    prob_yes = p_yes * p_color_yes * p_type_yes * p_origin_yes
    prob_no  = p_no  * p_color_no  * p_type_no  * p_origin_no
    print("\nProbability Yes:", prob_yes)
    print("Probability No :", prob_no)

