import ast
def bfs(tree, start, goal):
    queue = deque([[start]])
    visited = set()
    traversal = []
    while queue:
        path = queue.popleft()
        node = path[-1]
        if node not in visited:
            visited.add(node)
            traversal.append(node)
            if node == goal:
                return traversal, path
            if node in tree:
                for child in tree[node]:
                    if child not in visited:
                        queue.append(path + [child])
    return traversal, None
    
