def classify(color, type, origin):
    yes_rows = df[df["Car_Stolen"] == "Yes"]
    no_rows  = df[df["Car_Stolen"] == "No"]
    # Conditional probabilities
    p_color_yes  = len(yes_rows[yes_rows["Color"] == color]) / len(yes_rows)
