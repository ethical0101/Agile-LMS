8. import ast
def alphabeta(node, maximizing, alpha, beta):
    if isinstance(node, int):
        return node

    if maximizing:
        value = float('-inf')
        for child in node:
            value = max(value, alphabeta(child, False, alpha, beta))
            alpha = max(alpha, value)
            if beta <= alpha:
                break
        return value
    else:
        value = float('inf')
        for child in node:
            value = min(value, alphabeta(child, True, alpha, beta))
            beta = min(beta, value)
            if beta <= alpha:
                break
        return value
