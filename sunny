import heapq
def a_star(cap1, cap2, goal):
    start = (0, 0)
    pq = [(0, start, [])]
    visited = set()
    while pq:
        cost, (x, y), path = heapq.heappop(pq)
        if x == goal or y == goal:
            return path + [(x, y)]
        if (x, y) in visited:
            continue
        visited.add((x, y))
        moves = [
            (cap1, y), (x, cap2),   # fill jugs
            (0, y), (x, 0),         # empty jugs
            (x - min(x, cap2-y), y + min(x, cap2-y)),  # pour jug1->jug2
            (x + min(y, cap1-x), y - min(y, cap1-x))   # pour jug2->jug1
        ]
        for nx, ny in moves:
            if (nx, ny) not in visited:
                h = abs(goal - nx) + abs(goal - ny)
                heapq.heappush(pq, (cost + 1 + h, (nx, ny), path + [(x, y)]))
