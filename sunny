# Minimax Algorithm
def minimax_collapsed(tree, maximizingPlayer, level=0):
    # Base case: leaf node (score)
    if not isinstance(tree, list):
        return tree
    # Recursively evaluate child nodes
    child_values = [
        minimax_collapsed(child, not maximizingPlayer, level + 1)
        for child in tree
    ]
    # Collapse values based on player
    if maximizingPlayer:
        max_val = max(child_values)
        print(f"Level {level} Max node: {child_values} -> {max_val}")
        return max_val
    else:
        min_val = min(child_values)
        print(f"Level {level} Min node: {child_values} -> {min_val}")
        return min_val
