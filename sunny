# Monkey and Banana Problem using Planning
class MonkeyBanana:
    def __init__(self):
        self.state = {"monkey": "door", "box": "window", "banana": False}
        self.plan = []
    def move(self, pos):
        self.state["monkey"] = pos
        self.plan.append(f"Monkey moves to {pos}")
    def push(self, pos):
        self.state["monkey"] = pos
        self.state["box"] = pos
        self.plan.append(f"Monkey pushes box to {pos}")
    def climb(self):
        self.plan.append("Monkey climbs on the box")
    def grab(self):
        self.state["banana"] = True
        self.plan.append("Monkey grabs the banana")
    def solve(self):
        if self.state["monkey"] != "window":
            self.move("window")
        if self.state["box"] != "center":
            self.push("center")
        self.climb()
        self.grab()
        return self.plan
